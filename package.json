{
  "name": "trailmark",
  "version": "0.1.0",
  "description": "Record a web walkthrough and export it as a test-case clickpath",
  "main": "./out/main/index.js",
  "author": "Sumit Singwal",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/recorder/cli.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "verify:env": "electron out/main/index.js --smoke",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "bundle:chromium": "node scripts/bundle-chromium.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist:mac": "npm run bundle:chromium && npm run build && electron-builder --mac",
    "dist:win": "npm run bundle:chromium && npm run build && electron-builder --win",
    "dist": "npm run bundle:chromium && npm run build && electron-builder --mac --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
